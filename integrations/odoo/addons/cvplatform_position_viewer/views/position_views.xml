<odoo>
    <record id="view_cvplatform_position_list" model="ir.ui.view">
        <field name="name">cvplatform.position.list</field>
        <field name="model">cvplatform.position</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="company"/>
                <field name="published_cv_count" string="Published CVs"/>
                <field name="source_generated_at" string="Data generated"/>
                <field name="imported_at" string="Last import"/>
            </list>
        </field>
    </record>
    <record id="view_cvplatform_position_form" model="ir.ui.view">
        <field name="name">cvplatform.position.form</field>
        <field name="model">cvplatform.position</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="company"/><field name="published_cv_count" string="Published CVs"/><field name="source_url" widget="url"/></group>
                        <group><field name="external_id"/><field name="source_generated_at" string="Data generated"/><field name="imported_at" string="Last import"/></group>
                    </group>
                    <separator string="Attributes and aggregated results"/>
                    <field name="attribute_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="name" string="Attribute"/>
                            <field name="data_type" string="Type"/>
                            <field name="value_count" string="Filled"/>
                            <field name="missing_count" string="Missing"/>
                            <field name="summary" string="Results"/>
                        </list>
                        <form create="0" edit="0" delete="0">
                            <group><field name="name"/><field name="data_type"/><field name="value_count"/><field name="missing_count"/></group>
                            <field name="has_numeric" invisible="1"/>
                            <field name="has_average_days" invisible="1"/>
                            <group invisible="not has_numeric"><field name="minimum"/><field name="average"/><field name="maximum"/></group>
                            <group invisible="data_type != 'Date'"><field name="earliest_date"/><field name="latest_date"/></group>
                            <group invisible="data_type != 'Period'"><field name="earliest_start"/><field name="latest_end"/><field name="average_days" invisible="not has_average_days"/><field name="open_ended_count"/></group>
                            <group><field name="summary"/><field name="values_withheld"/></group>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_cvplatform_position_search" model="ir.ui.view">
        <field name="name">cvplatform.position.search</field>
        <field name="model">cvplatform.position</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="company"/><filter name="with_cvs" string="With published CVs" domain="[('published_cv_count', '&gt;', 0)]"/></search></field>
    </record>
    <record id="action_cvplatform_positions" model="ir.actions.act_window">
        <field name="name">Imported positions</field>
        <field name="res_model">cvplatform.position</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p>Use Import position to load a position with its API token from CV Platform.</p></field>
    </record>
</odoo>
