<odoo>
    <record id="view_cvplatform_import_wizard" model="ir.ui.view">
        <field name="name">cvplatform.import.wizard.form</field>
        <field name="model">cvplatform.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import position">
                <p>Generate an API token on the position edit page in CV Platform. Paste it below to import the position and its aggregated results. Importing the same position again updates its existing record.</p>
                <group><field name="api_token" password="True" placeholder="cvp_…"/></group>
                <footer><button name="action_import" string="Import position" type="object" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="action_cvplatform_import" model="ir.actions.act_window">
        <field name="name">Import position</field>
        <field name="res_model">cvplatform.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
